{
  "name": "multi-vendor-ecommerce-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Production-style multi-vendor marketplace based on the provided SRS.",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:browser": "playwright test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css,prisma}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@eslint/js": "^9.39.4",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.73.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss": "8.5.33",
    "@jest/reporters": { "glob": "14.0.6" },
    "jest-config": { "glob": "14.0.6" },
    "jest-runtime": { "glob": "14.0.6" },
    "@nestjs/cli": { "glob": "14.0.6" },
    "@prisma/config@6.19.3": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.22.5"
    }
  }
}
